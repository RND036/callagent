GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-live-preview
# Voice. If it still changes mid-call, try GEMINI_TEMPERATURE=0.7 or another
# voice such as Kore. Leave GEMINI_TEMPERATURE blank to use the model default.
GEMINI_VOICE_NAME=Aoede
GEMINI_TEMPERATURE=
# Salon clock, used for "today/tomorrow" when booking.
NAILAGENT_TIMEZONE=Asia/Colombo
# Record calls to data/recordings/ (shown in Call History).
NAILAGENT_RECORDINGS_ENABLED=true
# Asterisk is expected to run on the same Lightsail box and dial in over
# loopback (see the AudioSocket() dialplan action in /etc/asterisk/extensions.conf)
# -- keep this at 127.0.0.1 unless the bridge and Asterisk are on different hosts.
# Port 8090 matches what's already wired into the live dialplan.
NAILAGENT_WS_HOST=127.0.0.1
NAILAGENT_WS_PORT=8090
NAILAGENT_START_TIMEOUT_SECONDS=15
# AudioSocket packet type selects the rate; a PSTN/SIP trunk realistically
# negotiates 8kHz, so this is a real resample up to Gemini's 16kHz input,
# not a passthrough. Confirm against a real test call before changing.
NAILAGENT_AUDIOSOCKET_SAMPLE_RATE_HZ=8000

# Near-field noise gate: only the caller's voice (clearly louder than the
# background) reaches Gemini; TV/traffic/other people nearby become silence.
# Each call logs a "Noise gate" line with measured levels -- tune from that.
# Raise MIN_RMS/OPEN_RATIO if noise still gets through, lower if quiet
# callers get cut off.
NAILAGENT_NOISE_GATE_ENABLED=true
NAILAGENT_NOISE_GATE_MIN_RMS=400
NAILAGENT_NOISE_GATE_OPEN_RATIO=3.0

# MCP server for call transfer. AudioSocket has no transfer primitive of its
# own (hangup can go over the socket directly), so leave this blank until a
# replacement MCP-compatible endpoint exists; transfer tool calls will log
# and no-op until then.
MCP_SERVER_URL=
MCP_API_KEY=

# Call stability (the agent reconnects to Gemini by itself; see gemini_session/live_session.py).
NAILAGENT_MAX_CALL_SECONDS=900
# How long one Gemini outage may last before the agent gives up on the call (the caller hears
# silence meanwhile). A dropped call is saved as "AI Dropped" and leaves an urgent callback message.
NAILAGENT_RECONNECT_WINDOW_SECONDS=20
# client_content (default) or realtime_text, if the model rejects mid-call notes.
NAILAGENT_LIVE_NOTE_MODE=client_content
# Turn-taking: low | high (start/end sensitivity), silence before the agent answers.
NAILAGENT_VAD_START_SENSITIVITY=low
NAILAGENT_VAD_END_SENSITIVITY=low
NAILAGENT_VAD_SILENCE_MS=1000
NAILAGENT_VAD_PREFIX_PADDING_MS=300

# Copy the uploaded language-menu recording here so Asterisk's dialplan menu can play it (leave unset to skip)
# NAILAGENT_ASTERISK_MENU_PATH=/var/lib/asterisk/sounds/nailagent/lang-menu.wav
