GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-live-preview
# FreeSWITCH is expected to run on the same VDC box and dial in over
# loopback (see the uuid_audio_stream dialplan action) -- keep this at
# 127.0.0.1 unless the bridge and FreeSWITCH are on different hosts.
NAILAGENT_WS_HOST=127.0.0.1
NAILAGENT_WS_PORT=8766
NAILAGENT_START_TIMEOUT_SECONDS=15
NAILAGENT_FS_SAMPLE_RATE_HZ=16000

# MCP server for call transfer/hangup. There is currently no FreeSWITCH-side
# transfer backend (mod_audio_stream has no WS-level transfer mechanism), so
# leave this blank until a replacement MCP-compatible endpoint exists;
# transfer/hangup tool calls will log and no-op until then.
MCP_SERVER_URL=
MCP_API_KEY=
